{
  "name": "kevnex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/web --filter ./apps/api dev",
    "dev:frontend": "pnpm --filter ./apps/web dev",
    "dev:backend": "pnpm --filter ./apps/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter ./apps/api migration:run",
    "test": "pnpm --filter ./apps/api test",
    "test:ui": "playwright test",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/generate-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10"
  }
}
