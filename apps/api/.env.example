NODE_ENV=development
PORT=3014
APP_ORIGIN=http://localhost:5184
DATABASE_URL=postgresql://kevnex:replace-with-local-database-password@localhost:5433/kevnex
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Smart Reader <hello@kevnex.local>
SMTP_USER=
SMTP_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kevnex-local
S3_SECRET_KEY=replace-with-local-storage-password
S3_BUCKET=kevnex-private
S3_CREATE_BUCKET=true
MAX_UPLOAD_MB=50

# Phase 5: enabling AI/RAG or selecting a provider fails startup. No credentials needed.
AI_ENABLED=false
AI_PROVIDER=disabled
RAG_ENABLED=false
# UTF-16 character limits, not model tokens. Surrounding text has no source yet.
AI_CONTEXT_SELECTION_CHARS=10000
AI_CONTEXT_SURROUNDING_CHARS=4000
AI_CONTEXT_QUESTION_CHARS=2000
AI_CONTEXT_NOTE_CHARS=5000
AI_CONTEXT_TOTAL_CHARS=24000
RAG_CHUNK_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=200
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_VERBOSE=false
