NODE_ENV=development
PORT=3014
APP_ORIGIN=http://localhost:5184
DATABASE_URL=postgresql://kevnex:replace-with-local-database-password@localhost:5433/kevnex
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7
COOKIE_SECURE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Smart Reader <hello@kevnex.local>
SMTP_USER=
SMTP_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kevnex-local
S3_SECRET_KEY=replace-with-local-storage-password
S3_BUCKET=kevnex-private
S3_CREATE_BUCKET=true
MAX_UPLOAD_MB=50

# Phase 6. Missing credentials disable only the relevant capabilities.
AI_ENABLED=true
AI_PROVIDER=user
RAG_ENABLED=true
# JSON object of version -> base64-encoded 32-byte server encryption key. No real key in this file.
AI_ENCRYPTION_KEYS={}
AI_ENCRYPTION_KEY_VERSION=v1
# Exact private origins explicitly trusted by the administrator, e.g. http://localhost:11434
AI_ALLOWED_PRIVATE_ORIGINS=
PROJECT_EMBEDDING_PROVIDER=openai
PROJECT_EMBEDDING_MODEL=text-embedding-3-small
PROJECT_EMBEDDING_DIMENSIONS=1536
PROJECT_EMBEDDING_VERSION=openai-small-v1
PROJECT_EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
INDEX_CONCURRENCY=1
INDEX_MAX_MB=50
INDEX_MAX_PAGES=2000
INDEX_MAX_EXTRACTED_BYTES=10000000
INDEX_MAX_CHUNKS=30000
RAG_CHUNK_TOKENS=600
RAG_OVERLAP_TOKENS=80
RAG_MIN_SCORE=0.25
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_BYTES=24000
AI_DAILY_INDEX_PAGES=2000
AI_DAILY_EMBEDDING_TOKENS=2000000
AI_DAILY_QUERIES=100
AI_DAILY_LLM_REQUESTS=100
# Selection context character limits; model-specific embedding limits above use cl100k_base tokens.
AI_CONTEXT_SELECTION_CHARS=10000
AI_CONTEXT_SURROUNDING_CHARS=4000
AI_CONTEXT_QUESTION_CHARS=2000
AI_CONTEXT_NOTE_CHARS=5000
AI_CONTEXT_TOTAL_CHARS=24000
RAG_CHUNK_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=200
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_VERBOSE=false
